{
  "name": "root",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bootstrap": "npm install",
    "build": "lerna run build",
    "build-dev": "lerna run build-dev",
    "release": "npm run build && lerna version --exact",
    "quickrelease": "lerna version --exact",
    "changed": "lerna changed",
    "publish-all": "lerna run build && lerna publish from-package --yes",
    "prepare": "husky install"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^8.0.0",
    "lerna": "^9.0.7",
    "lint-staged": "^15.2.2"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "npx prettier --write",
      "npx eslint --fix"
    ]
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "globby": "^11.1.0",
    "axios": "^1.18.1",
    "decode-uri-component": "^0.5.0",
    "nx": {
      ".": "^22.7.12",
      "brace-expansion": "^5.0.9",
      "smol-toml": "^1.7.1"
    },
    "pacote": "^21.5.1",
    "uuid": "^11.1.1",
    "flatted": "^3.4.2",
    "minimatch@<3.1.3": "^3.1.4",
    "lerna": {
      "js-yaml": "^4.3.1"
    },
    "lodash": "^4.18.1",
    "jsonpath-plus": "^10.3.0",
    "node-fetch": "^2.7.0",
    "pdfjs-dist": "^4.3.0",
    "esbuild": "^0.25.0",
    "d3-color": "^3.1.0",
    "d3-scale": "^4.0.2",
    "tar": "^7.5.8",
    "d3-interpolate": "^3.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "isomorphic-fetch": "^3.0.0"
  }
}

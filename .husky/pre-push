#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Full gate, but only when pushing to a branch that ships. Feature-branch
# pushes stay instant; the release branches are where a regression becomes
# everyone else's problem.
#
# This is a local guardrail, not enforcement: `--no-verify` skips it, and so
# does anyone who has not run `npm install`. Enforcement would need a required
# status check on the branch, which is a separate organisational change.
GUARDED="NEXT-RELEASE STAGING master"
ZERO="0000000000000000000000000000000000000000"

should_run=0
while read -r _local_ref local_sha remote_ref _remote_sha; do
  # Branch deletion pushes a zero sha and has nothing to verify.
  [ "$local_sha" = "$ZERO" ] && continue

  branch="${remote_ref#refs/heads/}"
  for guarded in $GUARDED; do
    if [ "$branch" = "$guarded" ]; then
      should_run=1
      echo "pre-push: $branch is a release branch, running full checks."
    fi
  done
done

if [ "$should_run" -eq 0 ]; then
  exit 0
fi

if ! npm run verify --silent; then
  echo ""
  echo "pre-push: checks failed, push aborted."
  echo "Push anyway with --no-verify if you know what you are doing."
  exit 1
fi
